<%
# Parameters:
#  dayOfMonth: Any day of the month to render the header for.
%>

<% @time_span_to_display&.each do |currentDay|%>
  <%
    klass = ''
    klass += ' firstDayOfMonth' if currentDay.day == 1
    klass += ' lastDayOfMonth' if currentDay.day == currentDay.end_of_month.day
    klass += ' weekend' if currentDay.cwday == 6 || currentDay.cwday == 7
    klass += ' lastDayOfWeek' if currentDay.cwday == 7
  %>
  <th class="day-of-month<%= klass %>" scope="col">
    <%= tag.small currentDay.day.to_s %>
  </th>
<% end %>