<%
# Parameters:
#  dayOfWeek: Any day of the week to render the header for.
%>

<% @time_span_to_display&.each do |currentDay|%>
  <%
    klass = ''
    klass += ' firstDayOfWeek' if currentDay.cwday == 1
    klass += ' lastDayOfWeek' if currentDay.cwday == 7
    klass += ' weekend' if currentDay.cwday == 6 || currentDay.cwday == 7
    klass += ' firstDayOfMonth' if currentDay.day == 1
  %>
  <th class="workload_hdr day-of-week<%= klass %>" scope="col">
    <%= tag.small day_name(currentDay.cwday).first %>
  </th>
<% end %>