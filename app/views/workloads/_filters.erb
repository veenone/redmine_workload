<div class="content-title"><%= l(:workload_title) %> <%= l(:workload_show_filters) %></div>

<%= project_group_filtering_info %>

<%= form_tag({}, {:method => :get, :id => 'filter_form', :class => 'filters'}) do %>
  <div id="query_form_with_buttons" class="hide-when-print">
    <div id="query_form_content">
      <fieldset id="date_filters" class="collapsible">
        <legend onclick="toggleFieldset(this);" class="icon icon-expanded">
          <%= sprite_icon("chevron-down") %>
          <%= l(:workload_show_range) %>
        </legend>
        <div class="timespan">      
          <table>
            <tr>          		
              <td>
                <%= label_tag :workload_first_day, l(:workload_show_rangefrom) %>	     	  	
              </td>
              <td>
                <%= text_field_tag :workload_first_day, @first_day, :name => 'workload[first_day]', :size => 10 %>
                <%= calendar_for('workload_first_day') %>
              </td>
            </tr>
            <tr>
              <td><%= label_tag :workload_last_day, l(:workload_show_rangeto) %></td>
              <td><%= text_field_tag :workload_last_day, @last_day, :name => 'workload[last_day]', :size => 10 %><%= calendar_for('workload_last_day') %></td>
            </tr>
            <tr>
              <td><%= label_tag :workload_start_date, l(:workload_show_today) %></td>
              <td><%= text_field_tag :workload_start_date, @today, :name => 'workload[start_date]', :size => 10 %><%= calendar_for('workload_start_date') %></td>
            </tr>
          </table>
        </div>    
      </fieldset>

      <fieldset id="user_filters" class="collapsible">
        <legend onclick="toggleFieldset(this);" class="icon icon-expanded">
          <%= sprite_icon("chevron-down") %>
          <%= l(:workload_show_filter_user_legend) %>
        </legend>
        <div>
          <div class="users">
            <%= label_tag :workload_users, l(:workload_show_filter_user) %>
            <%= select_tag :workload_users, user_options_for_select(@users&.allowed_to_display, @users&.selected), :name => 'workload[users][]', :multiple => true, :onchange => "this.form.workload_groups.selectedIndex=-1;" %>
          </div>
          <br>
          <div class="groups">
            <%= label_tag :workload_groups, l(:workload_show_filter_group) %>
            <%= select_tag :workload_groups, group_options_for_select(@groups&.allowed_to_display, @groups&.selected), :name => 'workload[groups][]', :multiple => true, :onchange => "this.form.workload_users.selectedIndex=-1;" %>
          </div>
        </div>
      </fieldset>

      <% if User.current.admin? || User.current.allowed_to?(:view_all_workloads, nil, global: true) %>
        <fieldset id="display_options" class="collapsible collapsed">
          <legend onclick="toggleFieldset(this);" class="icon icon-collapsed">
            <%= sprite_icon("chevron-right") %>
            <%= l(:label_workload_display_options) %>
          </legend>
          <div style="display: none;">
            <p>
              <label>
                <%= check_box_tag 'workload[view_all_users]', 'true', 
                    User.current.pref[:workload_view_all_users] == 'true' ||
                    (User.current.pref[:workload_view_all_users].blank? && 
                     Setting.plugin_redmine_workload['default_view_all_users'] == 'checked'),
                    onchange: 'updateUserPreference(this);' %>
                <%= l(:label_view_all_users_by_default) %>
              </label>
              <em class='info'><%= l(:info_view_all_users_by_default) %></em>
            </p>
          </div>
        </fieldset>
      <% end %>
    </div>

    <p class="buttons">
      <%= link_to_function sprite_icon('checked', l(:button_apply)), 'jQuery("#filter_form").submit()', :class => 'icon icon-checked' %>
      <%= link_to sprite_icon('reload', l(:button_clear)), {}, :class => 'icon icon-reload' %>
    </p>
  </div>
<% end %>

<script>
function toggleFieldset(element) {
  var fieldset = element.parentNode;
  var content = fieldset.querySelector('div');
  var icon = element.querySelector('svg use');
  
  if (fieldset.classList.contains('collapsed')) {
    // Expand
    fieldset.classList.remove('collapsed');
    element.classList.remove('icon-collapsed');
    element.classList.add('icon-expanded');
    content.style.display = 'block';
    if (icon) {
      icon.setAttribute('href', icon.getAttribute('href').replace('chevron-right', 'chevron-down'));
    }
  } else {
    // Collapse
    fieldset.classList.add('collapsed');
    element.classList.remove('icon-expanded');
    element.classList.add('icon-collapsed');
    content.style.display = 'none';
    if (icon) {
      icon.setAttribute('href', icon.getAttribute('href').replace('chevron-down', 'chevron-right'));
    }
  }
}

function updateUserPreference(checkbox) {
  var value = checkbox.checked ? 'true' : 'false';
  
  // Save preference via AJAX
  $.ajax({
    url: '<%= url_for(controller: 'my', action: 'account') %>',
    type: 'PATCH',
    data: {
      'pref[workload_view_all_users]': value,
      authenticity_token: $('meta[name="csrf-token"]').attr('content')
    },
    success: function() {
      // Optionally reload the page to reflect the change
      if (window.location.search === '' || window.location.search === '?') {
        window.location.reload();
      }
    }
  });
}
</script>