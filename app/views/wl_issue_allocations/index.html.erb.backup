<div class="contextual">
  <%= link_to l(:button_back), issue_path(@issue), class: 'icon icon-cancel' %>
</div>

<h2><%= l(:workload_issue_allocation_site_title) %></h2>

<div class="issue-info-box">
  <h3><%= link_to "##{@issue.id}", issue_path(@issue) %>: <%= @issue.subject %></h3>
  <p>
    <strong><%= l(:field_assigned_to) %>:</strong> <%= @issue.assigned_to || l(:label_none) %><br/>
    <strong><%= l(:field_start_date) %>:</strong> <%= format_date(@issue.start_date) || l(:label_none) %><br/>
    <strong><%= l(:field_due_date) %>:</strong> <%= format_date(@issue.due_date) || l(:label_none) %><br/>
    <strong><%= l(:field_estimated_hours) %>:</strong> <%= @issue.estimated_hours || 0 %>h<br/>
    <strong><%= l(:field_done_ratio) %>:</strong> <%= @issue.done_ratio %>%<br/>
    <strong><%= l(:label_estimated_remaining) %>:</strong> <%= number_with_precision(@estimated_remaining, precision: 2) %>h
  </p>
</div>

<p class="description">
  <%= l(:workload_issue_allocation_description) %>
  <br/>
  <%= l(:help_issue_allocation) %>
</p>

<% if @issue.start_date.nil? || @issue.due_date.nil? || @issue.estimated_hours.nil? %>
  <div class="warning">
    <%= l(:error_issue_missing_dates_or_estimate) %>
  </div>
<% end %>

<div class="allocation-actions">
  <%= form_tag(auto_distribute_wl_issue_allocations_path, method: :post, style: 'display: inline;') do %>
    <%= hidden_field_tag :issue_id, @issue.id %>
    <%= submit_tag l(:button_auto_distribute),
                   class: 'icon icon-reload',
                   title: l(:help_auto_distribute),
                   data: { confirm: l(:text_are_you_sure) } %>
  <% end %>

  <%= form_tag(reset_wl_issue_allocations_path, method: :post, style: 'display: inline; margin-left: 10px;') do %>
    <%= hidden_field_tag :issue_id, @issue.id %>
    <%= submit_tag l(:button_reset_allocations),
                   class: 'icon icon-del',
                   title: l(:help_reset_allocations),
                   data: { confirm: l(:text_are_you_sure) } %>
  <% end %>
</div>

<%= form_tag(bulk_update_wl_issue_allocations_path, method: :post, id: 'allocation-form') do %>
  <%= hidden_field_tag :issue_id, @issue.id %>
  <%= hidden_field_tag :first_day, @first_day %>
  <%= hidden_field_tag :last_day, @last_day %>

  <div class="autoscroll">
    <table class="list issue-allocations">
      <thead>
        <tr>
          <th><%= l(:field_date) %></th>
          <th><%= l(:field_day_of_week) %></th>
          <th><%= l(:field_hours) %></th>
          <th><%= l(:label_status) %></th>
        </tr>
      </thead>
      <tbody>
        <% total_allocated = 0.0 %>
        <% @date_range.each do |date| %>
          <% allocation = @allocations_by_date[date] %>
          <% is_weekend = [6, 7].include?(date.cwday) %>
          <% is_working_day = !is_weekend %>

          <% # Determine if this date is within issue range %>
          <% within_issue_range = (@issue.start_date.nil? || date >= @issue.start_date) &&
                                   (@issue.due_date.nil? || date <= @issue.due_date) %>

          <% css_class = [] %>
          <% css_class << 'weekend' if is_weekend %>
          <% css_class << 'outside-range' unless within_issue_range %>
          <% css_class << 'has-allocation' if allocation %>

          <% hours_value = allocation&.hours %>
          <% total_allocated += hours_value.to_f if hours_value %>

          <tr class="<%= css_class.join(' ') %>">
            <td><%= format_date(date) %></td>
            <td><%= day_name(date.cwday) %></td>
            <td>
              <%= text_field_tag "allocations[#{date}]",
                                 hours_value,
                                 size: 5,
                                 placeholder: "0.0",
                                 class: 'allocation-hours',
                                 disabled: !within_issue_range %>
            </td>
            <td>
              <% if !within_issue_range %>
                <span class="status-badge outside">Outside Issue Range</span>
              <% elsif allocation %>
                <span class="status-badge manual"><%= l(:label_manual_allocation) %></span>
              <% elsif is_working_day %>
                <span class="status-badge auto"><%= l(:label_automatic_allocation) %></span>
              <% else %>
                <span class="status-badge weekend">Weekend</span>
              <% end %>
            </td>
          </tr>
        <% end %>
      </tbody>
      <tfoot>
        <tr>
          <th colspan="2"><%= l(:label_total_allocated) %></th>
          <th class="total-hours"><%= number_with_precision(total_allocated, precision: 2) %>h</th>
          <th></th>
        </tr>
        <tr>
          <th colspan="2"><%= l(:label_estimated_remaining) %></th>
          <th class="estimated-hours"><%= number_with_precision(@estimated_remaining, precision: 2) %>h</th>
          <th></th>
        </tr>
        <tr class="<%= total_allocated == @estimated_remaining ? 'balanced' : 'unbalanced' %>">
          <th colspan="2"><%= l(:label_allocation_difference) %></th>
          <th class="difference-hours">
            <%= number_with_precision(total_allocated - @estimated_remaining, precision: 2) %>h
          </th>
          <th>
            <% if (total_allocated - @estimated_remaining).abs < 0.01 %>
              <span class="status-badge balanced">✓ Balanced</span>
            <% elsif total_allocated > @estimated_remaining %>
              <span class="status-badge over">⚠ Over-allocated</span>
            <% else %>
              <span class="status-badge under">⚠ Under-allocated</span>
            <% end %>
          </th>
        </tr>
      </tfoot>
    </table>
  </div>

  <p>
    <%= submit_tag l(:button_save), class: 'button-small' %>
  </p>
<% end %>

<div class="date-range-selector">
  <%= form_tag(wl_issue_allocations_path, method: :get) do %>
    <%= hidden_field_tag :issue_id, @issue.id %>
    <%= label_tag :first_day, l(:label_date_from) %>
    <%= text_field_tag :first_day, @first_day, size: 10 %>
    <%= calendar_for('first_day') %>

    <%= label_tag :last_day, l(:label_date_to) %>
    <%= text_field_tag :last_day, @last_day, size: 10 %>
    <%= calendar_for('last_day') %>

    <%= submit_tag l(:button_apply), class: 'button-small' %>
  <% end %>
</div>

<style>
  .issue-info-box {
    background-color: #f9f9f9;
    border: 1px solid #ddd;
    padding: 15px;
    margin-bottom: 20px;
    border-radius: 3px;
  }

  .issue-info-box h3 {
    margin-top: 0;
    margin-bottom: 10px;
  }

  .allocation-actions {
    margin: 15px 0;
    padding: 10px;
    background-color: #fafafa;
    border: 1px solid #e0e0e0;
    border-radius: 3px;
  }

  .issue-allocations tr.weekend {
    background-color: #f5f5f5;
  }

  .issue-allocations tr.outside-range {
    background-color: #ffeaea;
    opacity: 0.6;
  }

  .issue-allocations tr.has-allocation {
    background-color: #e8f5e9;
    font-weight: bold;
  }

  .allocation-hours {
    text-align: right;
    font-family: monospace;
  }

  .status-badge {
    display: inline-block;
    padding: 2px 8px;
    border-radius: 3px;
    font-size: 11px;
    font-weight: bold;
  }

  .status-badge.manual {
    background-color: #4caf50;
    color: white;
  }

  .status-badge.auto {
    background-color: #2196f3;
    color: white;
  }

  .status-badge.weekend {
    background-color: #9e9e9e;
    color: white;
  }

  .status-badge.outside {
    background-color: #ff5722;
    color: white;
  }

  .status-badge.balanced {
    background-color: #4caf50;
    color: white;
  }

  .status-badge.over {
    background-color: #ff9800;
    color: white;
  }

  .status-badge.under {
    background-color: #ffeb3b;
    color: #333;
  }

  .issue-allocations tfoot {
    background-color: #f0f0f0;
    font-weight: bold;
  }

  .issue-allocations tfoot th {
    text-align: left;
    padding: 8px;
  }

  .total-hours, .estimated-hours, .difference-hours {
    text-align: right !important;
    font-family: monospace;
    font-size: 14px;
  }

  .date-range-selector {
    margin-top: 20px;
    padding: 10px;
    background-color: #f9f9f9;
    border: 1px solid #ddd;
  }

  .date-range-selector label {
    margin-right: 5px;
  }

  .date-range-selector input[type="text"] {
    margin-right: 15px;
  }

  .warning {
    padding: 10px;
    background-color: #fff3cd;
    border: 1px solid #ffc107;
    border-radius: 3px;
    margin: 15px 0;
  }
</style>
